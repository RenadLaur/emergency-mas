<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="generated/astana_pilot.net.xml"/>
        <additional-files value="generated/astana_pilot.poly.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <report>
        <no-step-log value="true"/>
        <duration-log.disable value="true"/>
    </report>
</configuration>
